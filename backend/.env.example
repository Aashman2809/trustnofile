PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=100
# Optional overrides (default: backend/storage/uploads and backend/data)
# STORAGE_DIR=
# DATA_DIR=
# Static analysis
# YARA_PATH=yara
# YARA_RULES_DIR=
# MODULE_TIMEOUT_MS=30000
# Risk thresholds (must be ascending; otherwise defaults are used)
# RISK_MODERATE=25
# RISK_HIGH=50
# RISK_VERY_HIGH=75

# Optional Gemini development provider (not configured until both key and model are set)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_TIMEOUT_MS=15000

# Optional PostgreSQL persistence (apply docs/database-schema.sql first)
# DATABASE_URL=postgresql://trustnofile:change-me@localhost:5432/trustnofile
# DATABASE_SSL=false

# Optional disposable Docker sandbox (Linux ELF runner only)
# SANDBOX_IMAGE=trustnofile-runner:local
# SANDBOX_DOCKER_PATH=docker
# SANDBOX_TIMEOUT_MS=30000
