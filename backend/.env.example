# Local development defaults. Never commit filled-in credentials.
DEPLOYMENT_MODE=local
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
STORAGE_PROVIDER=local
DATA_DIR=./data
STORAGE_DIR=./storage/uploads
AUTH_REQUIRED=false
REQUIRE_DATABASE=false
REQUIRE_STORAGE=false
LLM_PROVIDER=gemini
GEMINI_MODEL=
LLM_TIMEOUT_MS=15000
SANDBOX_PROVIDER=docker
SANDBOX_TIMEOUT_MS=30000

# AWS/ECS configuration (set through ECS task config, not this committed file).
# DEPLOYMENT_MODE=aws
# AWS_REGION=
# AWS_S3_BUCKET=
# STORAGE_PROVIDER=s3
# ANALYSIS_QUEUE_PROVIDER=sqs
# ANALYSIS_QUEUE_URL=
# DATABASE_URL=                   # Secrets Manager
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=                # optional trusted CA PEM
# REQUIRE_DATABASE=true
# REQUIRE_STORAGE=true
# AUTH_REQUIRED=true
# AUTH_ALLOWED_USER_ID=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# GEMINI_API_KEY=                 # Secrets Manager
# FRONTEND_ORIGIN=https://your-frontend-domain
# TRUST_PROXY=true
# SANDBOX_PROVIDER=batch
# SANDBOX_BATCH_JOB_QUEUE=
# SANDBOX_BATCH_JOB_DEFINITION=
