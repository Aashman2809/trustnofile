FROM python:3.12-alpine
COPY batch-runner.py /batch-runner.py
RUN chmod 0555 /batch-runner.py
# The trusted supervisor starts as root only to place the payload under a separate UID.
# Untrusted ELF executes as UID/GID 65534 with no inherited application credentials.
USER root
ENTRYPOINT ["python3", "/batch-runner.py"]
